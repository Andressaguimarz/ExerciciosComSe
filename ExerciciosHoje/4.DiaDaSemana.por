programa {
  funcao inicio() {
    inteiro diadasemana

    escreva("insira um número de 1 á 7: ")
    leia(diadasemana)
    se(diadasemana == 1) {
      escreva("Hoje é domingo")
    }
    se(diadasemana == 2){
      escreva("Hoje é segunda")
    }
    se(diadasemana == 3){
      escreva("Hoje é terça")
    }
    se(diadasemana == 4){
      escreva("Hoje é quarta")
    }
    se(diadasemana == 5){
      escreva("Hoje é quinta")
    }
    se(diadasemana == 6){
      escreva("Hoje é sexta")
    }
    se(diadasemana == 7){
      escreva("Hoje é sábado")
    }
  }
}
